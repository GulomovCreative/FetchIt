    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "typecheck": "tsc -p ."
  },
  "keywords": [
    "MODX Extra"
  ],
  "author": {
    "name": "Gulomov Bakhtovar",
    "email": "gulomovcreative@gmail.com"
  },
  "license": "GPL-2.0-only",
  "engines": {
    "node": ">=22.12"
  },
  "browserslist": "defaults and supports es6-module",
  "dependencies": {
    "notyf": "^3.10.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "jsdom": "^30.1.1",
    "oxlint": "^1.85.0",
    "rolldown": "^1.2.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
