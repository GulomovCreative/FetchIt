{
  "name": "fetchit",
  "version": "1.1.3",
  "private": true,
  "description": "MODX Revolution extra for submitting forms with the Fetch API",
  "type": "module",
  "main": "assets/components/fetchit/js/fetchit.js",
  "scripts": {
    "build": "rolldown -c",
    "build:check": "npm run build && git diff --exit-code -- assets/components/fetchit/js",
